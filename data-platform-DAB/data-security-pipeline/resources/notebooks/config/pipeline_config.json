{
  "pipeline": {
    "name": "data-security-pipeline",
    "description": "Centralized configuration for row-level security, column-level security, RBAC, ABAC policies, and data masking",
    "version": "1.1.0"
  },
  "dab_variables": {
    "catalog": {
      "spark_conf_key": "project.target.catalog",
      "description": "DAB catalog variable (var.catalog)"
    },
    "gold_schema": {
      "spark_conf_key": "gold.target.schema",
      "description": "DAB gold schema variable (var.gold_schema)"
    }
  },
  "catalog": {
    "name": "${catalog}",
    "comment": "Unity Catalog catalog sourced from DAB variable var.catalog"
  },
  "schemas": [
    {
      "name": "${gold_schema}",
      "catalog": "${catalog}",
      "comment": "Gold schema for curated customer data"
    }
  ],
  "tables": [
    {
      "full_name": "${catalog}.${gold_schema}.current_customers",
      "catalog": "${catalog}",
      "schema": "${gold_schema}",
      "name": "current_customers",
      "type": "materialized_view",
      "comment": "Gold current-state customer dimension (materialized view) derived from SCD2 history",
      "columns": [
        {"name": "customer_id", "type": "BIGINT", "comment": "Customer unique identifier"},
        {"name": "first_name", "type": "STRING", "comment": "Customer first name"},
        {"name": "last_name", "type": "STRING", "comment": "Customer last name"},
        {"name": "full_name", "type": "STRING", "comment": "Customer full name"},
        {"name": "email_address", "type": "STRING", "comment": "Customer email address"},
        {"name": "phone_number", "type": "STRING", "comment": "Customer phone number"},
        {"name": "address", "type": "STRING", "comment": "Customer street address"},
        {"name": "city", "type": "STRING", "comment": "Customer city"},
        {"name": "state", "type": "STRING", "comment": "Customer state or province"},
        {"name": "country", "type": "STRING", "comment": "Customer country (used for row-level filtering)"},
        {"name": "continent", "type": "STRING", "comment": "Customer continent"},
        {"name": "postal_zip_code", "type": "STRING", "comment": "Customer postal/zip code"},
        {"name": "gender", "type": "STRING", "comment": "Customer gender"},
        {"name": "record_effective_from", "type": "TIMESTAMP", "comment": "SCD2 effective from timestamp"},
        {"name": "record_effective_to", "type": "TIMESTAMP", "comment": "SCD2 effective to timestamp"},
        {"name": "environment_name", "type": "STRING", "comment": "Pipeline environment name"},
        {"name": "source_table_name", "type": "STRING", "comment": "Source table name"}
      ]
    }
  ],
  "governed_tags": [
    {
      "key": "sensitivity",
      "values": ["high", "medium", "low"],
      "comment": "Data sensitivity classification level"
    },
    {
      "key": "pii",
      "values": ["email", "phone", "address", "name", "postal_code"],
      "comment": "PII data type classification"
    },
    {
      "key": "geo_region",
      "values": ["country", "continent", "global"],
      "comment": "Geographic region for row-level filtering"
    },
    {
      "key": "classification",
      "values": ["confidential", "internal", "public"],
      "comment": "Overall data classification tag"
    }
  ],
  "tag_applications": {
    "table_tags": [
      {
        "table": "${catalog}.${gold_schema}.current_customers",
        "tags": {
          "sensitivity": "high",
          "classification": "confidential"
        }
      }
    ],
    "column_tags": [
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "email_address", "tags": {"pii": "email"}},
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "phone_number", "tags": {"pii": "phone"}},
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "address", "tags": {"pii": "address"}},
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "full_name", "tags": {"pii": "name"}},
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "first_name", "tags": {"pii": "name"}},
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "last_name", "tags": {"pii": "name"}},
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "postal_zip_code", "tags": {"pii": "postal_code"}},
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "country", "tags": {"geo_region": "country"}},
      {"table": "${catalog}.${gold_schema}.current_customers", "column": "gender", "tags": {"sensitivity": "medium"}}
    ]
  },
  "udfs": [
    {
      "name": "mask_email",
      "full_name": "${catalog}.${gold_schema}.mask_email",
      "catalog": "${catalog}",
      "schema": "${gold_schema}",
      "type": "column_mask",
      "language": "python",
      "return_type": "STRING",
      "comment": "Masks email to show only domain for non-exempt users",
      "code": "if email_address is None:\n    return None\nparts = email_address.split('@')\nif len(parts) == 2:\n    return '****@' + parts[1]\nreturn '****'",
      "params": [{"name": "email_address", "type": "STRING"}]
    },
    {
      "name": "mask_phone",
      "full_name": "${catalog}.${gold_schema}.mask_phone",
      "catalog": "${catalog}",
      "schema": "${gold_schema}",
      "type": "column_mask",
      "language": "python",
      "return_type": "STRING",
      "comment": "Masks phone number to show only last 4 digits",
      "code": "if phone_number is None:\n    return None\nreturn 'XXX-XXX-' + phone_number[-4:] if len(phone_number) >= 4 else 'XXX-XXX-XXXX'",
      "params": [{"name": "phone_number", "type": "STRING"}]
    },
    {
      "name": "mask_name",
      "full_name": "${catalog}.${gold_schema}.mask_name",
      "catalog": "${catalog}",
      "schema": "${gold_schema}",
      "type": "column_mask",
      "language": "python",
      "return_type": "STRING",
      "comment": "Masks full name to show only first initial",
      "code": "if full_name is None:\n    return None\nreturn full_name[0] + '****' if len(full_name) > 0 else '****'",
      "params": [{"name": "full_name", "type": "STRING"}]
    },
    {
      "name": "mask_address",
      "full_name": "${catalog}.${gold_schema}.mask_address",
      "catalog": "${catalog}",
      "schema": "${gold_schema}",
      "type": "column_mask",
      "language": "python",
      "return_type": "STRING",
      "comment": "Masks street address for non-exempt users",
      "code": "if address is None:\n    return None\nreturn '****'",
      "params": [{"name": "address", "type": "STRING"}]
    },
    {
      "name": "mask_postal_code",
      "full_name": "${catalog}.${gold_schema}.mask_postal_code",
      "catalog": "${catalog}",
      "schema": "${gold_schema}",
      "type": "column_mask",
      "language": "python",
      "return_type": "STRING",
      "comment": "Masks postal/zip code to show only first 3 characters",
      "code": "if postal_zip_code is None:\n    return None\nreturn postal_zip_code[:3] + '***' if len(postal_zip_code) > 3 else '****'",
      "params": [{"name": "postal_zip_code", "type": "STRING"}]
    },
    {
      "name": "filter_by_country",
      "full_name": "${catalog}.${gold_schema}.filter_by_country",
      "catalog": "${catalog}",
      "schema": "${gold_schema}",
      "type": "row_filter",
      "language": "sql",
      "return_type": "BOOLEAN",
      "comment": "Row filter that restricts rows to the user's authorized country using is_member()",
      "code": "is_member(country)",
      "params": [{"name": "country", "type": "STRING"}]
    }
  ],
  "rbac": {
    "groups": [
      {"name": "data_admins", "comment": "Data administrators with full access to customer data"},
      {"name": "analysts", "comment": "Data analysts with read-only access (PII masked)"},
      {"name": "us_analysts", "comment": "US-based analysts with US region access"},
      {"name": "eu_analysts", "comment": "EU-based analysts with EU region access"}
    ],
    "grants": [
      {
        "principal": "data_admins",
        "privilege": "ALL PRIVILEGES",
        "object_type": "SCHEMA",
        "object": "${catalog}.${gold_schema}"
      },
      {
        "principal": "analysts",
        "privilege": "SELECT",
        "object_type": "TABLE",
        "object": "${catalog}.${gold_schema}.current_customers"
      },
      {
        "principal": "us_analysts",
        "privilege": "SELECT",
        "object_type": "TABLE",
        "object": "${catalog}.${gold_schema}.current_customers"
      },
      {
        "principal": "eu_analysts",
        "privilege": "SELECT",
        "object_type": "TABLE",
        "object": "${catalog}.${gold_schema}.current_customers"
      },
      {
        "principal": "us_analysts",
        "privilege": "USE SCHEMA",
        "object_type": "SCHEMA",
        "object": "${catalog}.${gold_schema}"
      },
      {
        "principal": "eu_analysts",
        "privilege": "USE SCHEMA",
        "object_type": "SCHEMA",
        "object": "${catalog}.${gold_schema}"
      }
    ]
  },
  "row_filters": [
    {
      "table": "${catalog}.${gold_schema}.current_customers",
      "udf": "${catalog}.${gold_schema}.filter_by_country",
      "using_columns": ["country"]
    }
  ],
  "column_masks": [
    {
      "table": "${catalog}.${gold_schema}.current_customers",
      "column": "email_address",
      "udf": "${catalog}.${gold_schema}.mask_email",
      "using_columns": ["email_address"]
    },
    {
      "table": "${catalog}.${gold_schema}.current_customers",
      "column": "phone_number",
      "udf": "${catalog}.${gold_schema}.mask_phone",
      "using_columns": ["phone_number"]
    },
    {
      "table": "${catalog}.${gold_schema}.current_customers",
      "column": "full_name",
      "udf": "${catalog}.${gold_schema}.mask_name",
      "using_columns": ["full_name"]
    },
    {
      "table": "${catalog}.${gold_schema}.current_customers",
      "column": "address",
      "udf": "${catalog}.${gold_schema}.mask_address",
      "using_columns": ["address"]
    },
    {
      "table": "${catalog}.${gold_schema}.current_customers",
      "column": "postal_zip_code",
      "udf": "${catalog}.${gold_schema}.mask_postal_code",
      "using_columns": ["postal_zip_code"]
    }
  ],
  "abac_policies": [
    {
      "name": "email_redaction",
      "scope_type": "CATALOG",
      "scope": "${catalog}",
      "policy_type": "COLUMN_MASK",
      "udf": "${catalog}.${gold_schema}.mask_email",
      "to_principals": ["analysts", "us_analysts", "eu_analysts"],
      "except_principals": ["data_admins"],
      "when_condition": "has_tag_value('sensitivity', 'high')",
      "match_columns": "has_tag_value('pii', 'email') AS email_col",
      "on_column": "email_col",
      "using_columns": ["email_col"],
      "comment": "ABAC policy: mask email columns tagged with pii=email across the catalog"
    },
    {
      "name": "phone_redaction",
      "scope_type": "CATALOG",
      "scope": "${catalog}",
      "policy_type": "COLUMN_MASK",
      "udf": "${catalog}.${gold_schema}.mask_phone",
      "to_principals": ["analysts", "us_analysts", "eu_analysts"],
      "except_principals": ["data_admins"],
      "when_condition": "has_tag_value('sensitivity', 'high')",
      "match_columns": "has_tag_value('pii', 'phone') AS phone_col",
      "on_column": "phone_col",
      "using_columns": ["phone_col"],
      "comment": "ABAC policy: mask phone columns tagged with pii=phone across the catalog"
    },
    {
      "name": "name_redaction",
      "scope_type": "CATALOG",
      "scope": "${catalog}",
      "policy_type": "COLUMN_MASK",
      "udf": "${catalog}.${gold_schema}.mask_name",
      "to_principals": ["analysts", "us_analysts", "eu_analysts"],
      "except_principals": ["data_admins"],
      "when_condition": "has_tag_value('sensitivity', 'high')",
      "match_columns": "has_tag_value('pii', 'name') AS name_col",
      "on_column": "name_col",
      "using_columns": ["name_col"],
      "comment": "ABAC policy: mask name columns tagged with pii=name across the catalog"
    },
    {
      "name": "address_redaction",
      "scope_type": "CATALOG",
      "scope": "${catalog}",
      "policy_type": "COLUMN_MASK",
      "udf": "${catalog}.${gold_schema}.mask_address",
      "to_principals": ["analysts", "us_analysts", "eu_analysts"],
      "except_principals": ["data_admins"],
      "when_condition": "has_tag_value('sensitivity', 'high')",
      "match_columns": "has_tag_value('pii', 'address') AS addr_col",
      "on_column": "addr_col",
      "using_columns": ["addr_col"],
      "comment": "ABAC policy: mask address columns tagged with pii=address across the catalog"
    },
    {
      "name": "postal_code_redaction",
      "scope_type": "CATALOG",
      "scope": "${catalog}",
      "policy_type": "COLUMN_MASK",
      "udf": "${catalog}.${gold_schema}.mask_postal_code",
      "to_principals": ["analysts", "us_analysts", "eu_analysts"],
      "except_principals": ["data_admins"],
      "when_condition": "has_tag_value('sensitivity', 'high')",
      "match_columns": "has_tag_value('pii', 'postal_code') AS postal_col",
      "on_column": "postal_col",
      "using_columns": ["postal_col"],
      "comment": "ABAC policy: mask postal code columns tagged with pii=postal_code across the catalog"
    },
    {
      "name": "region_isolation",
      "scope_type": "SCHEMA",
      "scope": "${catalog}.${gold_schema}",
      "policy_type": "ROW_FILTER",
      "udf": "${catalog}.${gold_schema}.filter_by_country",
      "to_principals": ["us_analysts", "eu_analysts"],
      "except_principals": ["data_admins"],
      "when_condition": "has_tag_value('sensitivity', 'high')",
      "match_columns": "has_tag('geo_region') AS region_col",
      "using_columns": ["region_col"],
      "comment": "ABAC policy: country-based row filtering for geo-restricted customer data"
    }
  ]
}